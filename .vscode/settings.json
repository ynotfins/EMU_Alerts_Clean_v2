{
  "cSpell.words": [
    "emualerts",
    "EMU", 
    "firebase",
    "Firestore",
    "appspot",
    "googleapis",
    "googleusercontent",
    "APPINVITE",
    "SIGNIN",
    "GCM",
    "worklets",
    "Schedulable",
    "Turbopack",
    "FERPA",
    "prepush",
    "precommit"
  ],
  "cSpell.ignorePaths": [
    "**/node_modules/**",
    "**/build/**", 
    "**/dist/**",
    "**/.git/**",
    "**/Backup*/**",
    "**/OneDrive/Desktop/Backup*/**"
  ],
  "files.exclude": {
    "**/node_modules": true,
    "**/.git": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true,
    "**/Backup*/**": true
  }
}
